# Homing 的 nginx 反向代理示例。把 homing.example.com 换成你的域名，证书路径换成你的。
# 服务端跑在本机 8790 端口（Docker 部署时建议端口只绑 127.0.0.1）。
# 用了 X-Real-IP 时，服务端要设 HOMING_TRUST_PROXY=1，登录防爆破才能按真实 IP 计数。
server {
    listen 80;
    server_name homing.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name homing.example.com;

    ssl_certificate     /etc/ssl/homing/fullchain.pem;
    ssl_certificate_key /etc/ssl/homing/privkey.pem;

    client_max_body_size 4m;

    location / {
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # SSE 实时推送：必须关缓冲，否则消息会憋在代理里不下发；
    # 服务端每 20 秒发一次心跳，读超时要比它长
    location = /api/stream {
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
