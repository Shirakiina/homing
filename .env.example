# cp .env.example .env 后填写。.env 含密钥，不要入库。
# 所有配置项见 config.example.py，环境变量名为 HOMING_<名字>。

# 登录密码（查看界面用）
HOMING_PASSWORD=change-me
# 推送 token（写入接口用），生成：openssl rand -hex 16
HOMING_TOKEN=change-me

# 对外访问地址，用于「接入」面板生成 webhook 地址；本机使用留空
# HOMING_PUBLIC_URL=https://homing.example.com

# 部署在反向代理后面、且代理设置了 X-Real-IP 时打开（登录防爆破按真实 IP 计数）
# HOMING_TRUST_PROXY=1

# AI 整理（可选）：任意 OpenAI 兼容接口，到 /v1 为止。消息正文会发送到这个地址
# HOMING_AI_URL=http://127.0.0.1:11434/v1
# HOMING_AI_MODEL=
# HOMING_AI_KEY=
