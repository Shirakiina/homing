<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_settings"
        android:shortcutId="settings"
        android:shortcutShortLabel="@string/settings">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="io.github.homing.SettingsActivity"
            android:targetPackage="io.github.homing" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_refresh"
        android:shortcutId="check"
        android:shortcutShortLabel="@string/check_now">
        <intent
            android:action="io.github.homing.CHECK"
            android:targetClass="io.github.homing.SettingsActivity"
            android:targetPackage="io.github.homing" />
    </shortcut>
</shortcuts>
