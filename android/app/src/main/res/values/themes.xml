<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#5B5BD6</color>
    <color name="window">#F7F7F8</color>

    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:windowBackground">@color/window</item>
    </style>

    <style name="Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:alpha">0.7</item>
        <item name="android:textAppearance">@android:style/TextAppearance.Material.Caption</item>
    </style>

    <style name="Action" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">start|center_vertical</item>
    </style>
</resources>
